# Build an explicit application source context. Local credentials and scheduler logs
# must never enter Docker's build context.
**
!Dockerfile
!package.json
!package-lock.json
!apps/
!apps/server/
!apps/server/package.json
!apps/server/tsconfig.json
!apps/server/src/
!apps/server/src/**
!apps/web/
!apps/web/package.json
!apps/web/index.html
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/src/
!apps/web/src/**
!apps/web/public/
!apps/web/public/**
!apps/web/test/
!apps/web/test/**
!docs/
!docs/afterlife/
!docs/afterlife/fixtures/
!docs/afterlife/fixtures/*.json
!packages/
!packages/shared/
!packages/shared/package.json
!packages/shared/tsconfig.json
!packages/shared/src/
!packages/shared/src/**
**/.env*
**/node_modules
**/*.pem
**/*.key
**/check_usage*
