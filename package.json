{
  "name": "afterlife",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/server"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch apps/server/src/server.ts",
    "start": "node --env-file-if-exists=.env apps/server/dist/server.js",
    "build": "npm run build --workspace @afterlife/server",
    "test": "npm run test --workspace @afterlife/server",
    "typecheck": "npm run typecheck --workspace @afterlife/server"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
