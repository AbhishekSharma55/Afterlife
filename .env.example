HOST=127.0.0.1
PORT=4310
PUBLIC_ORIGIN=http://localhost:4310
DATABASE_URL=postgresql://afterlife:afterlife@localhost:5432/afterlife
# Rehearsal mode must be explicitly enabled for in-memory development.
ALLOW_REHEARSAL=false
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:4310/auth/twitch/callback
# Both scenes and episode recaps use this provider/model. Restart after changing.
AI_PROVIDER=openrouter
AI_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_API_KEY=
# For direct OpenAI evaluation, set AI_PROVIDER=openai and AI_MODEL to your OpenAI model ID.
OPENAI_API_KEY=
# Legacy fallback when AI_MODEL is empty and AI_PROVIDER=openai:
OPENAI_MODEL=
OFFLINE_INTERVAL_MS=21600000

# Compose only: use an ignored .env.compose.local as described in the deployment guide.
POSTGRES_PASSWORD=
